{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@mfa/contracts": ["packages/contracts/src/index.ts"],
      "@mfa/decision-core": ["packages/decision-core/src/index.ts"],
      "@mfa/demo-data": ["packages/demo-data/src/index.ts"]
    }
  },
  "include": [
    "apps/**/src/**/*.ts",
    "apps/**/src/**/*.tsx",
    "apps/**/tests/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/tests/**/*.ts",
    "vitest.config.ts"
  ]
}
